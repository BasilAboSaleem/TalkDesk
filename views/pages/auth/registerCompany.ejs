<!DOCTYPE html>
<html lang="en">

<%- include('../../partials/head') %>
<style>
  .logo {
    width: 200px;
    height: auto;
    margin-bottom: -100px;
    margin-top: -80px;
  }

  .text-danger {
    font-size: 0.85rem;
  }
  #spinnerContainer {
  display: none; 
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.8); 
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.spinner-border {
  width: 3rem;
  height: 3rem;
  border-width: 0.4rem;
}

#spinnerContainer p {
  margin-top: 1rem;
  font-weight: bold;
  font-size: 1.2rem;
  color: #4B61DD;
}

</style>

<body>
  <div id="app">
    <section class="section">
      <div class="container mt-5">
        <div class="row">
          <div class="col-12 col-sm-10 offset-sm-1 col-md-8 offset-md-2 col-lg-8 offset-lg-2 col-xl-8 offset-xl-2">
            <div class="login-brand">
              <img src="/assets/logo.png" alt="TalkDesk Logo" class="logo mb-4">
            </div>

            <div class="card card-primary" style="margin-top: -100px;">
              <div class="card-header">
                <h4><span style="color: rgb(75, 97, 221);">Register Your Company</span></h4>
              </div>

              <div class="card-body">
                <form id="registerCompanyForm" method="post" enctype="multipart/form-data">

                  <!-- Company Info -->
                  <div class="form-divider">Company Information</div>

                  <div class="form-group">
                    <label for="company_name">Company Name</label>
                    <input id="company_name" type="text" class="form-control" name="company[name]" required>
                  </div>

                  <div class="form-group">
                    <label for="company_email">Company Email</label>
                    <input id="company_email" type="email" class="form-control" name="company[email]" required>
                    <span class="text-danger" id="error_company_email"></span>
                  </div>

                  <div class="form-group">
                    <label for="subdomain">Subdomain</label>
                    <input id="subdomain" type="text" class="form-control" name="company[subdomain]" required placeholder="e.g. mycompany">
                    <small class="text-muted">Your workspace will be accessed via: <strong>subdomain.talkdesk.com</strong></small>
                    <span class="text-danger" id="error_company_subdomain"></span>
                  </div>

                  <div class="form-group">
                    <label for="industry">Industry</label>
                    <input id="industry" type="text" class="form-control" name="company[industry]">
                  </div>

                  <div class="form-group">
                    <label for="description">Company Description</label>
                    <textarea id="description" class="form-control" name="company[description]" rows="3"></textarea>
                  </div>

                  <div class="form-group">
                    <label for="logo">Company Logo</label>
                    <input id="logo" type="file" class="form-control-file" name="logo">
                  </div>

                  <div class="form-group">
                    <label for="language">Default Language</label>
                    <select class="form-control" name="company[defaultLanguage]">
                      <option value="en">English</option>
                      <option value="ar">Arabic</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="theme">Default Theme</label>
                    <select class="form-control" name="company[defaultTheme]">
                      <option value="light">Light</option>
                      <option value="dark">Dark</option>
                    </select>
                  </div>

                  <!-- Admin Info -->
                  <div class="form-divider">Admin User Information</div>

                  <div class="form-group">
                    <label for="admin_name">Admin Name</label>
                    <input id="admin_name" type="text" class="form-control" name="user[name]" required>
                  </div>

                  <div class="form-group">
                    <label for="admin_email">Admin Email</label>
                    <input id="admin_email" type="email" class="form-control" name="user[email]" required>
                    <span class="text-danger" id="error_user_email"></span>
                  </div>

                  <div class="form-group">
                    <label for="admin_password">Password</label>
                    <input id="admin_password" type="password" class="form-control" name="user[password]" required>
                    <small class="form-text text-muted">Must be at least 8 characters, one uppercase and one number.</small>
                    <span class="text-danger" id="error_user_password"></span>
                  </div>

                  <div class="form-group">
                    <label for="admin_password2">Confirm Password</label>
                    <input id="admin_password2" type="password" class="form-control" name="user[confirmPassword]" required>
                    <span class="text-danger" id="error_user_confirmPassword"></span>
                  </div>

                  <div class="form-group">
                    <div class="custom-control custom-checkbox">
                      <input type="checkbox" name="agree" class="custom-control-input" id="agree" required>
                      <label class="custom-control-label" for="agree">I agree with the terms and conditions</label>
                    </div>
                  </div>

                  <div class="form-group">
                    <button type="submit" id="submitBtn" class="btn btn-primary btn-lg btn-block">Register Company</button>
                  </div>

                  <div class="form-group text-center" id="spinnerContainer" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                      <span class="sr-only">Loading...</span>
                    </div>
                    <p class="mt-2">Registering company, please wait...</p>
                  </div>
                </form>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>
  </div>

  <%- include('../../partials/script') %>

  <script>
  document.getElementById('registerCompanyForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const spinner = document.getElementById('spinnerContainer');
    const submitBtn = document.getElementById('submitBtn');

    // إظهار السبينر وتعطيل الزر
    submitBtn.disabled = true;
    spinner.style.display = 'block';

    // تفريغ أخطاء قديمة
    ['company_email', 'company_subdomain', 'user_email', 'user_password', 'user_confirmPassword'].forEach(id => {
      const el = document.getElementById(`error_${id}`);
      if (el) el.textContent = '';
    });

    const password = document.getElementById('admin_password').value;
    const confirmPassword = document.getElementById('admin_password2').value;
    const hasUpper = /[A-Z]/.test(password);
    const hasNumber = /\d/.test(password);
    const hasLength = password.length >= 8;

    // تحقق من الباسوورد
    if (!hasLength || !hasUpper || !hasNumber) {
      document.getElementById('error_user_password').textContent =
        'Password must be at least 8 characters, include at least one uppercase letter and one number.';
      spinner.style.display = 'none';
      submitBtn.disabled = false;
      return;
    }

    if (password !== confirmPassword) {
      document.getElementById('error_user_confirmPassword').textContent = 'Passwords do not match.';
      spinner.style.display = 'none';
      submitBtn.disabled = false;
      return;
    }

    const form = e.target;
    const formData = new FormData(form);

    try {
      const res = await fetch('/register-company', {
        method: 'POST',
        body: formData,
      });

      const data = await res.json();

      if (res.status === 400 && data.errors) {
        // عرض الأخطاء
        for (const key in data.errors) {
          const formattedKey = key.replace('.', '_');
          const el = document.getElementById(`error_${formattedKey}`);
          if (el) el.textContent = data.errors[key];
        }

        spinner.style.display = 'none';
        submitBtn.disabled = false;
      } else if (res.status === 200 && data.redirect) {
        // نجاح
        window.location.href = data.redirect;
      } else {
        alert('Unexpected error occurred.');
        spinner.style.display = 'none';
        submitBtn.disabled = false;
      }
    } catch (err) {
      console.error(err);
      alert('Error submitting the form.');
      spinner.style.display = 'none';
      submitBtn.disabled = false;
    }
  });
</script>

</body>
</html>

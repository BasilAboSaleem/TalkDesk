<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<%- include('../../../partials/head.ejs') %>

<body class="<%= themeClass %>">
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../../partials/navbar.ejs') %>
      <%- include('../../../partials/sidebar.ejs') %>

      <!-- Main Content -->
      <div class="main-content">
        <section class="section">
          <div class="container mt-5">
            <div class="row">
                  <% if (success && success.length > 0) { %>
              <div class="alert alert-success"><%= success[0] %></div>
            <% } %>
            <% if (error && error.length > 0) { %>
              <div class="alert alert-danger"><%= error[0] %></div>
            <% } %>
              <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">

                <div class="card card-primary animated fadeIn">
                  <div class="card-header">
                    <h4><%= t('department.addTitle') %></h4>
                  </div>

                  <div class="card-body">
                    <form action="/admin/departments/new" method="POST">

                      <!-- Department Name -->
                      <div class="form-group">
                        <label for="name"><%= t('department.nameLabel') %></label>
                        <div class="input-group">
                          <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-building"></i></span>
                          </div>
                          <input id="name" name="name" type="text" class="form-control" required
                            placeholder="<%= t('department.namePlaceholder') %>">
                        </div>
                      </div>

                      <!-- Description -->
                      <div class="form-group">
                        <label for="description"><%= t('department.descriptionLabel') %></label>
                        <div class="input-group">
                          <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fas fa-align-left"></i></span>
                          </div>
                          <textarea id="description" name="description" class="form-control" rows="3"
                            placeholder="<%= t('department.descriptionPlaceholder') %>"></textarea>
                        </div>
                      </div>

                      <!-- Submit Button -->
                      <div class="form-group text-center">
                        <button type="submit" class="btn btn-primary btn-lg">
                          <i class="fas fa-plus-circle mr-1"></i> <%= t('department.addButton') %>
                        </button>
                      </div>

                    </form>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Footer -->
      <%- include('../../../partials/footer.ejs') %>
    </div>
  </div>

  <!-- JS Scripts -->
  <%- include('../../../partials/script.ejs') %>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<%- include('../../../partials/head.ejs') %>

<body class="<%= themeClass %>">
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../../partials/navbar.ejs') %>
      <%- include('../../../partials/sidebar.ejs') %>

      <!-- Main Content -->
      <div class="main-content">
        <section class="section">
          <div class="container mt-5">
            <div class="row">
   <!-- Flash Messages -->
          <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show flash-message" role="alert">
              <i class="fas fa-check-circle mr-2"></i> <%= success[0] %>
              <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
          <% } %>
          <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show flash-message" role="alert">
              <i class="fas fa-exclamation-triangle mr-2"></i> <%= error[0] %>
              <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
          <% } %>
              <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                <div class="card card-primary animated fadeIn">
                  <div class="card-header">
                    <h4><%= pageTitle %></h4>
                  </div>

                  <div class="card-body">
                   <form action="<%= formAction %>" method="POST">

  <% if (isEdit) { %>
    <input type="hidden" name="_method" value="PUT">
  <% } %>

  <!-- Department Name -->
  <div class="form-group">
    <label for="name"><%= t('department.nameLabel') %></label>
    <div class="input-group">
      <div class="input-group-prepend">
        <span class="input-group-text"><i class="fas fa-building"></i></span>
      </div>
      <input
        id="name"
        name="name"
        type="text"
        class="form-control"
        required
        placeholder="<%= t('department.namePlaceholder') %>"
        value="<%= department ? department.name : '' %>">
    </div>
  </div>

  <!-- Description -->
  <div class="form-group">
    <label for="description"><%= t('department.descriptionLabel') %></label>
    <div class="input-group">
      <div class="input-group-prepend">
        <span class="input-group-text"><i class="fas fa-align-left"></i></span>
      </div>
      <textarea
        id="description"
        name="description"
        class="form-control"
        rows="3"
        placeholder="<%= t('department.descriptionPlaceholder') %>"><%= department ? department.description : '' %></textarea>
    </div>
  </div>

  <!-- Submit Button -->
  <div class="form-group text-center">
    <button type="submit" class="btn btn-primary btn-lg">
      <i class="fas <%= isEdit ? 'fa-save' : 'fa-plus-circle' %> mr-1"></i>
      <%= submitLabel %>
    </button>
  </div>

</form>

                  </div>
                </div>

              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Footer -->
      <%- include('../../../partials/footer.ejs') %>
    </div>
  </div>

  <!-- JS Scripts -->
  <%- include('../../../partials/script.ejs') %>
</body>
</html>

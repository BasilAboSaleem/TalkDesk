<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<%- include('../../../partials/head.ejs') %>

<body class="<%= themeClass %>">
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../../partials/navbar.ejs') %>
      <%- include('../../../partials/sidebar.ejs') %>

      <!-- Main Content -->
      <div class="main-content">
        <section class="section">

          <!-- Flash Messages -->
          <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle mr-2"></i> <%= success[0] %>
              <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
          <% } %>
          <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-triangle mr-2"></i> <%= error[0] %>
              <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
          <% } %>

          <!-- Section Header -->
          <div class="section-header">
            <h1><%= t('department.pageTitle') %></h1>
            <div class="section-header-breadcrumb">
              <div class="breadcrumb-item active"><a href="/admin/dashboard"><%= t('breadcrumb.dashboard') %></a></div>
              <div class="breadcrumb-item"><%= t('department.pageTitle') %></div>
            </div>
          </div>

          <div class="section-body">
            <h2 class="section-title"><%= t('department.sectionTitle') %></h2>
            <p class="section-lead"><%= t('department.sectionLead') %></p>

            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h4><%= t('department.cardHeader') %></h4>
                <a href="/admin/departments/new" class="btn btn-primary">
                  <i class="fas fa-plus"></i> <%= t('department.addButton') %>
                </a>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col"><%= t('department.tableHeaders.name') %></th>
                        <th scope="col"><%= t('department.tableHeaders.description') %></th>
                        <th scope="col"><%= t('department.tableHeaders.createdAt') %></th>
                        <th scope="col"><%= t('department.tableHeaders.actions') %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (departments && departments.length > 0) { %>
                        <% departments.forEach((department, index) => { %>
                          <tr>
                            <th scope="row"><%= index + 1 %></th>
                            <td><%= department.name %></td>
                            <td><%= department.description || '-' %></td>
                            <td><%= department.createdAt.toLocaleDateString() %></td>
                       <td>
  <a href="/admin/departments/<%= department._id %>" class="btn btn-info btn-sm" title="<%= t('department.actions.view') %>">
    <i class="fas fa-eye"></i>
  </a>
  <a href="/admin/departments/<%= department._id %>/edit" class="btn btn-warning btn-sm" title="<%= t('department.actions.edit') %>">
    <i class="fas fa-edit"></i>
  </a>
  <!-- زر حذف يفتح المودال -->
  <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deleteModal-<%= department._id %>" title="<%= t('department.actions.delete') %>">
    <i class="fas fa-trash-alt"></i>
  </button>

  <!-- مودال التأكيد -->
  <div class="modal fade" id="deleteModal-<%= department._id %>" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel-<%= department._id %>" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content bg-dark text-white">
        <div class="modal-header border-danger">
          <h5 class="modal-title text-danger" id="deleteModalLabel-<%= department._id %>"><i class="fas fa-exclamation-triangle"></i> <%= t('department.deleteWarningTitle') %></h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="<%= t('common.close') %>">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p><strong><%= t('department.deleteWarningMessage') %></strong></p>
          <p><%= t('department.deleteConfirmText', { name: department.name }) %></p>
          <p class="text-danger font-weight-bold"><%= t('department.deleteIrreversible') %></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
          <form action="/admin/departments/<%= department._id %>?_method=DELETE" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-danger"><%= t('common.confirmDelete') %></button>
          </form>
        </div>
      </div>
    </div>
  </div>
</td>
                          </tr>
                        <% }) %>
                      <% } else { %>
                        <tr>
                          <td colspan="6" class="text-center"><%= t('department.noDepartments') %></td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

          </div>
        </section>
      </div>

      <!-- Footer -->
      <%- include('../../../partials/footer.ejs') %>
    </div>
  </div>

  <!-- JS Scripts -->
  <%- include('../../../partials/script.ejs') %>
</body>
</html>

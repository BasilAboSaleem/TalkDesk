<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<%- include('../../../partials/head.ejs') %>

<body class="<%= themeClass %>">
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../../partials/navbar.ejs') %>
      <%- include('../../../partials/sidebar.ejs') %>

      <div class="main-content">
        <section class="section">
          <div class="section-header">
            <h1><%= t('employee.edit.pageTitle') || 'Edit Employee' %></h1>
            <div class="section-header-breadcrumb">
              <div class="breadcrumb-item active"><a href="/admin/dashboard"><%= t('breadcrumb.dashboard') %></a></div>
              <div class="breadcrumb-item"><a href="/admin/employees"><%= t('employee.title') || 'Employees' %></a></div>
              <div class="breadcrumb-item"><%= employee.name %></div>
            </div>
          </div>

          <div class="section-body">
            <div class="card">
              <div class="card-header">
                <h4><%= t('employee.edit.cardHeader') || 'Edit Employee Department' %></h4>
              </div>
              <div class="card-body">
                <form action="/admin/employees/edit/<%= employee._id %>" method="POST">
                  <div class="row">

                    <!-- Name (readonly) -->
                    <div class="col-md-6 d-flex mb-3">
                      <strong class="w-50"><%= t('employee.tableHeaders.name') || 'Name' %>:</strong>
                      <span><%= employee.name %></span>
                    </div>

                    <!-- Email (readonly) -->
                    <div class="col-md-6 d-flex mb-3">
                      <strong class="w-50"><%= t('employee.tableHeaders.email') || 'Email' %>:</strong>
                      <span><%= employee.email %></span>
                    </div>

                    <!-- Current Department (editable) -->
                    <div class="col-md-6 d-flex mb-3">
                      <label class="w-50" for="department"><%= t('employee.tableHeaders.department') || 'Department' %>:</label>
                      <select name="department" id="department" class="form-control">
                        <option value=""><%= t('employee.edit.selectDepartment') || 'Select Department' %></option>
                        <% departments.forEach(dept => { %>
                          <option value="<%= dept._id %>" <%= employee.department && dept._id.equals(employee.department._id) ? 'selected' : '' %>><%= dept.name %></option>
                        <% }) %>
                      </select>
                    </div>

                    <!-- Status (readonly) -->
                    <div class="col-md-6 d-flex mb-3">
                      <strong class="w-50"><%= t('employee.tableHeaders.status') || 'Status' %>:</strong>
                      <span>
                        <% if (employee.status === 'online') { %>
                          <span class="badge badge-success"><%= t('employee.status.online') || 'Online' %></span>
                        <% } else if (employee.status === 'offline') { %>
                          <span class="badge badge-secondary"><%= t('employee.status.offline') || 'Offline' %></span>
                        <% } else if (employee.status === 'busy') { %>
                          <span class="badge badge-warning"><%= t('employee.status.busy') || 'Busy' %></span>
                        <% } %>
                      </span>
                    </div>

                  </div>

                  <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= t('common.saveChanges') || 'Save Changes' %></button>
                    <a href="/admin/employees" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> <%= t('common.backToList') || 'Back to Employees' %></a>
                  </div>
                </form>
              </div>
            </div>
          </div>

        </section>
      </div>

      <%- include('../../../partials/footer.ejs') %>
    </div>
  </div>

  <%- include('../../../partials/script.ejs') %>
</body>
</html>

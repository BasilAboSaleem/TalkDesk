<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<%- include('../../../partials/head.ejs') %>

<body class="<%= themeClass %>">
  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>
      <%- include('../../../partials/navbar.ejs') %>
      <%- include('../../../partials/sidebar.ejs') %>

      <div class="main-content">
        <section class="section">
          <div class="section-header">
            <h1><%= t('employee.view.pageTitle') || 'Employee Details' %></h1>
            <div class="section-header-breadcrumb">
              <div class="breadcrumb-item active"><a href="/admin/dashboard"><%= t('breadcrumb.dashboard') %></a></div>
              <div class="breadcrumb-item"><a href="/admin/employees"><%= t('employee.title') || 'Employees' %></a></div>
              <div class="breadcrumb-item"><%= employee.name %></div>
            </div>
          </div>

          <div class="section-body">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h4><%= t('employee.view.cardHeader') || 'Employee Information' %></h4>
                <!-- زر إرسال رسالة مباشر -->
                <a href="/admin/direct-messages/new?recipient=<%= employee._id %>" class="btn btn-info">
                  <i class="fas fa-envelope"></i> <%= t('employee.view.sendMessage') || 'Send Message' %>
                </a>
              </div>
              <div class="card-body">
                <div class="row">

                  <!-- الصورة الشخصية -->
                  <div class="col-md-3 mb-3 text-center">
                    <% if(employee.profileImage) { %>
                      <img src="<%= employee.profileImage %>" class="img-fluid rounded-circle" alt="<%= employee.name %>">
                    <% } else { %>
                      <img src="/images/default-user.png" class="img-fluid rounded-circle" alt="Default User">
                    <% } %>
                  </div>

                  <!-- البيانات الأساسية -->
                  <div class="col-md-9">
                    <div class="row">
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.name') || 'Name' %>:</strong>
                        <span><%= employee.name %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.email') || 'Email' %>:</strong>
                        <span><%= employee.email %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.role') || 'Role' %>:</strong>
                        <span><%= employee.role %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.department') || 'Department' %>:</strong>
                        <span><%= employee.department ? employee.department.name : '-' %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.company') || 'Company' %>:</strong>
                        <span><%= employee.company ? employee.company.name : '-' %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.status') || 'Status' %>:</strong>
                        <span>
                          <% if(employee.status === 'online') { %>
                            <span class="badge badge-success"><%= t('employee.status.online') || 'Online' %></span>
                          <% } else if(employee.status === 'offline') { %>
                            <span class="badge badge-secondary"><%= t('employee.status.offline') || 'Offline' %></span>
                          <% } else if(employee.status === 'busy') { %>
                            <span class="badge badge-warning"><%= t('employee.status.busy') || 'Busy' %></span>
                          <% } %>
                        </span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.language') || 'Language' %>:</strong>
                        <span><%= employee.language || '-' %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.theme') || 'Theme' %>:</strong>
                        <span><%= employee.theme || '-' %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.isDeleted') || 'Deleted' %>:</strong>
                        <span><%= employee.isDeleted ? t('common.yes') || 'Yes' : t('common.no') || 'No' %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.createdAt') || 'Created At' %>:</strong>
                        <span><%= employee.createdAt.toLocaleString() %></span>
                      </div>
                      <div class="col-md-6 d-flex mb-3">
                        <strong class="w-50"><%= t('employee.view.updatedAt') || 'Updated At' %>:</strong>
                        <span><%= employee.updatedAt.toLocaleString() %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- زر العودة -->
            <div class="mt-3">
              <a href="/admin/employees" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> <%= t('common.backToList') || 'Back to Employees' %>
              </a>
            </div>
          </div>
        </section>
      </div>

      <%- include('../../../partials/footer.ejs') %>
    </div>
  </div>

  <%- include('../../../partials/script.ejs') %>
</body>
</html>

<div class="main-sidebar sidebar-style-2">
  <aside id="sidebar-wrapper">
    <div class="sidebar-brand">
      <a href="/">TalkDesk</a>
    </div>
    <div class="sidebar-brand sidebar-brand-sm">
      <a href="/">TD</a>
    </div>

    <% if(user.role === 'superadmin') { %>
      <ul class="sidebar-menu">
        <li class="menu-header">Admin Panel</li>
        <li><a class="nav-link" href="/dashboard"><i class="fas fa-fire"></i><span>Dashboard</span></a></li>

        <li class="menu-header">Companies</li>
        <li><a class="nav-link" href="/sadmin/companies"><i class="fas fa-building"></i><span>All Companies</span></a></li>
        <li><a class="nav-link" href="/sadmin/companies/pending"><i class="fas fa-hourglass-half"></i><span>Pending Approval</span></a></li>
        <li><a class="nav-link" href="/sadmin/companies-deleted"><i class="fas fa-trash"></i><span>Deleted Companies</span></a></li>

        <li class="menu-header">Admins</li>
        <li><a class="nav-link" href="/sadmin/admins"><i class="fas fa-user-shield"></i><span>Company Admins</span></a></li>

        <li class="menu-header">Reports</li>
        <li><a class="nav-link" href="/sadmin/reports"><i class="fas fa-chart-bar"></i><span>System Reports</span></a></li>
        <li><a class="nav-link" href="/sadmin/logs"><i class="fas fa-clipboard-list"></i><span>Activity Logs</span></a></li>

        <li class="menu-header">Settings</li>
        <li><a class="nav-link" href="/sadmin/settings"><i class="fas fa-cogs"></i><span>Platform Settings</span></a></li>
      </ul>
    <% } else if(user.role === 'admin') { %>
      <ul class="sidebar-menu">
        <li class="menu-header">Company Panel</li>
        <li><a class="nav-link" href="/dashboard"><i class="fas fa-fire"></i><span>Dashboard</span></a></li>

        <!-- Employees collapsible -->
        <li class="dropdown">
          <a href="#" class="nav-link has-dropdown" data-toggle="dropdown">
            <i class="fas fa-users"></i><span>Employees</span>
          </a>
          <ul class="dropdown-menu">
            <li><a class="nav-link" href="/admin/employees/invite">Invite Employee</a></li>
            <li><a class="nav-link" href="/admin/employees">All Employees</a></li>
          </ul>
        </li>

        <!-- Departments collapsible -->
        <li class="dropdown">
          <a href="#" class="nav-link has-dropdown" data-toggle="dropdown">
            <i class="fas fa-building"></i><span>Departments</span>
          </a>
          <ul class="dropdown-menu">
            <li><a class="nav-link" href="/admin/departments/new">Add Department</a></li>
            <li><a class="nav-link" href="/admin/departments">All Departments</a></li>
            <li><a class="nav-link" href="/admin/departments/soft-deleted">Deleted Departments</a></li>
          </ul>
        </li>

        <!-- Direct Messages collapsible -->
        <li class="dropdown">
          <a href="#" class="nav-link has-dropdown" data-toggle="dropdown">
            <i class="fas fa-comments"></i><span>Direct Messages</span>
          </a>
          <ul class="dropdown-menu">
            <% directMessages.forEach(dm => { %>
              <li><a class="nav-link" href="/admin/chat/<%= dm.chatId %>"><i class="fas fa-user"></i> <%= dm.name %> <span class="badge badge-danger"><%= dm.unreadCount || 0 %></span></a></li>
            <% }) %>
            <li><a class="nav-link" href="/admin/chats/new"><i class="fas fa-plus"></i> Start New Chat</a></li>
          </ul>
        </li>

        <!-- Online Users collapsible -->
        <li class="dropdown">
          <a href="#" class="nav-link has-dropdown" data-toggle="dropdown">
            <i class="fas fa-circle text-success"></i><span>Online Users</span>
          </a>
          <ul class="dropdown-menu">
            <% onlineUsers.forEach(u => { %>
              <li><a class="nav-link" href="/admin/profile/<%= u.id %>"><%= u.name %></a></li>
            <% }) %>
          </ul>
        </li>

        <li class="menu-header">Settings</li>
        <li><a class="nav-link" href="/admin/settings"><i class="fas fa-cog"></i><span>Company Settings</span></a></li>
        <li><a class="nav-link" href="/admin/profile"><i class="fas fa-user"></i><span>My Profile</span></a></li>
      </ul>
    <% } else if(user.role === 'employee') { %>
      <ul class="sidebar-menu">
        <li class="menu-header">Employee Panel</li>
        <li><a class="nav-link" href="/employee/dashboard"><i class="fas fa-fire"></i><span>Dashboard</span></a></li>

        <li class="menu-header">Direct Messages</li>
        <% directMessages.forEach(dm => { %>
          <li><a class="nav-link" href="/employee/chat/<%= dm.chatId %>"><i class="fas fa-user"></i><span><%= dm.name %></span></a></li>
        <% }) %>
        <li><a class="nav-link" href="/employee/chats/new"><i class="fas fa-plus"></i><span>Start New Chat</span></a></li>

        <li class="menu-header">Online Users</li>
        <% onlineUsers.forEach(u => { %>
          <li><a class="nav-link" href="/employee/profile/<%= u.id %>"><i class="fas fa-circle text-success" style="font-size:0.7rem;"></i><span><%= u.name %></span></a></li>
        <% }) %>

        <li class="menu-header">My Department</li>
        <li><a class="nav-link" href="/employee/my-department"><i class="fas fa-users"></i><span>My Department</span></a></li>

        <li class="menu-header">Profile</li>
        <li><a class="nav-link" href="/employee/profile"><i class="fas fa-user"></i><span>My Profile</span></a></li>
      </ul>
    <% } %>
  </aside>
</div>
